{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleFileExtensions": ["ts", "js", "json", "node"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.tests.json" }]
  },
  "testMatch": ["**/__tests__/**/*.spec.ts"],
  "setupFilesAfterEnv": ["<rootDir>/__tests__/jest.setup.ts"],
  "verbose": true
}
